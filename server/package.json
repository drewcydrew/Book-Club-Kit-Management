{
  "name": "book-club-kit-server",
  "version": "1.0.0",
  "private": true,
  "description": "Shared-data API for the book club kit app",
  "main": "src/app.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test": "node --test",
    "migrate": "node --env-file-if-exists=../.env src/migrate.js",
    "repair-schema": "node --env-file-if-exists=../.env src/repair-schema.js",
    "seed": "node --env-file-if-exists=../.env src/seed.js",
    "import-titles": "node --env-file-if-exists=../.env src/import-titles.js",
    "enrich-titles": "node --env-file-if-exists=../.env src/enrich-titles.js",
    "create-kits": "node --env-file-if-exists=../.env src/create-title-kits.js",
    "import-demo-schedule": "node --env-file-if-exists=../.env src/import-demo-schedule.js",
    "import-demo-preferences": "node --env-file-if-exists=../.env src/import-demo-preferences.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.16.3"
  }
}
