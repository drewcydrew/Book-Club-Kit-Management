        "definition": "CHECK ((returned_copies >= 0))"
      }
    },
    "indexes": {
      "circulation_events_pkey": {
        "definition": "CREATE UNIQUE INDEX circulation_events_pkey ON circulation_events USING btree (id)",
        "valid": true,
        "ready": true
      }
    },
    "triggers": {
      "circulation_events_append_only": {
        "definition": "CREATE TRIGGER circulation_events_append_only BEFORE DELETE OR UPDATE ON circulation_events FOR EACH ROW EXECUTE FUNCTION reject_circulation_event_change()",
        "enabled": "O",
        "function_definition": "CREATE OR REPLACE FUNCTION reject_circulation_event_change()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n  RAISE EXCEPTION 'Circulation events are append-only' USING ERRCODE = '55000';\r\nEND;\r\n$function$\n"
      }
    }
  },
