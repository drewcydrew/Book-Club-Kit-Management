    "constraints": {
      "circulation_events_action_check": {
        "definition": "CHECK ((action = ANY (ARRAY['reserved'::text, 'picked up'::text, 'delivered'::text, 'returned'::text, 'inspected'::text, 'resolved'::text])))"
      },
